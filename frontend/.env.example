# PolicyGuard XRPL — frontend configuration.
#
# Copy to .env.local. Every value has a working default, so the local demo runs with
# no configuration at all.

# The instruction relay in front of the TEE extension.
#   Local demo:      http://127.0.0.1:6674  (./scripts/run-tee.sh)
#   Coston2 deploy:  your ngrok URL, the same EXT_PROXY_URL as the root .env
NEXT_PUBLIC_RELAYER_URL="http://127.0.0.1:6674"

# The deployed InstructionSender on Coston2. Leave empty to run in local TEE mode,
# where the enclave still enforces the policy but nothing is anchored on-chain.
# Written to config/extension.env by ./scripts/pre-build.sh as INSTRUCTION_SENDER.
NEXT_PUBLIC_INSTRUCTION_SENDER=""

# Coston2 RPC. The public endpoint is fine for the demo.
NEXT_PUBLIC_COSTON2_RPC="https://coston2-api.flare.network/ext/C/rpc"

# XRPL testnet JSON-RPC, used to read the account sequence and optionally submit a
# signed transaction. Neither is required for a policy decision.
NEXT_PUBLIC_XRPL_RPC="https://s.altnet.rippletest.net:51234/"
