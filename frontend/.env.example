# PolicyGuard XRPL — frontend.
#
# Copy to .env.local. NEXT_PUBLIC_INSTRUCTION_SENDER is required: there is no offline
# mode, because every decision is made by a contract on Flare and a TEE, not here.

# The deployed PolicyGuard InstructionSender. Written to config/extension.env as
# INSTRUCTION_SENDER by ./scripts/pre-build.sh.
NEXT_PUBLIC_INSTRUCTION_SENDER=""

# Which Flare network to talk to: coston2 | songbird | flare.
# Only coston2 has a public FCC deployment today — see the README network matrix.
NEXT_PUBLIC_FLARE_NETWORK="coston2"

# Optional RPC override. The public endpoint is used when this is empty.
NEXT_PUBLIC_FLARE_RPC=""

# Fee forwarded with each instruction, in wei. Registry minimum is 1000; the excess is
# returned to the claim-back address.
NEXT_PUBLIC_INSTRUCTION_FEE_WEI="1000000000000"

# XRPL testnet JSON-RPC, used to read the account sequence and optionally submit a
# signed transaction. Neither affects a policy decision.
NEXT_PUBLIC_XRPL_RPC="https://s.altnet.rippletest.net:51234/"

# --- server-side ------------------------------------------------------------

# The TEE proxy URL comes from the on-chain TeeInstructionsSent event, and results are
# fetched server-side because the proxy sends no CORS headers.
#
# Set this to true ONLY for local development, where the official simulated-TEE stack
# runs the proxy on localhost. It permits the result-fetching route to reach private
# and loopback addresses, which on a public deployment would let anyone probe the
# host's internal network.
FCC_ALLOW_PRIVATE_PROXY="false"
