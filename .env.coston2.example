# PolicyGuard XRPL — Coston2.
#
# STATUS: LIVE. Coston2 is the only network with a public FCC deployment today, and it
# is the network this project is built and tested against.
#
#   cp .env.coston2.example .env.local.coston2
#   bash ./scripts/use-chain.sh local coston2 go

# === Keys ==================================================================

# Funded Coston2 private key, hex, no 0x prefix. Deploys the contract and registers
# the extension. Fund it at https://faucet.flare.network/coston2
DEPLOYMENT_PRIVATE_KEY=""

# The address derived from DEPLOYMENT_PRIVATE_KEY. Becomes the extension owner.
INITIAL_OWNER="0x0000000000000000000000000000000000000000"

# Key the locally-run ext-proxy signs with. Only needed when you run the proxy.
PROXY_PRIVATE_KEY=""

# === Chain =================================================================

CHAIN=coston2
CHAIN_URL="https://coston2-api.flare.network/ext/C/rpc"
ADDRESSES_FILE="./config/coston2/deployed-addresses.json"

# The FCC diamond on Coston2, for reference. Read from ADDRESSES_FILE as FlareTeeManager.
#   0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE

LOCAL_MODE=false

# true runs the official simulated TEE (test attestation, MODE=1 in the container).
# This is Flare's own local setup, not a substitute implementation — the extension
# binary and the instruction path are identical. Only the hardware attestation is
# simulated. false requires a real GCP Confidential Space VM.
SIMULATED_TEE=true

# === Proxies ===============================================================

# Flare's hosted normal/FTDC proxy, used during TEE registration.
NORMAL_PROXY_URL="https://tee-proxy-coston2-1.flare.rocks"

# Your extension proxy, publicly reachable. `ngrok http 6674`, then paste the HTTPS
# URL here and re-run use-chain.sh. This URL is published on-chain in the TEE machine
# record, which is how the frontend discovers where to collect results.
EXT_PROXY_URL=""

# === Extension =============================================================

LANGUAGE=go

# Fee forwarded with each instruction, in wei. The registry minimum is 1000.
# FEE_WEI=1000000000000

# TEE governance signer set. Defaults to INITIAL_OWNER with a threshold of 1.
# GOVERNANCE_SIGNERS="0xAbc...,0xDef..."
# GOVERNANCE_THRESHOLD=2
