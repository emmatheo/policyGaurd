# PolicyGuard XRPL — Flare mainnet.
#
# STATUS: PREPARED, NOT LIVE. DO NOT USE TO GUARD REAL FUNDS.
#
# Flare Confidential Compute is described in the official documentation as "in the
# final stages of development and not yet a fully public production system". There is
# no public mainnet FCC contract set, so this configuration cannot be completed
# honestly today.
#
# The blanks below are blank deliberately. Filling them with plausible-looking
# addresses would produce something that appears deployable and is not, which is worse
# than an obvious gap — this file is a placeholder, not a working config.
#
# Two conditions must hold before mainnet is appropriate, beyond the addresses simply
# existing:
#
#   1. SIMULATED_TEE must be false and the extension must run on a real GCP
#      Confidential Space VM with genuine hardware attestation. A simulated TEE offers
#      no protection for the signing key.
#   2. The extension must persist keys through Flare's WalletKeyManager facet. As
#      built, wallets live in enclave memory and do not survive a restart — acceptable
#      for a testnet MVP, unacceptable when the key controls real XRP.
#
# See the README's "Known limitations" for both.

# === Keys ==================================================================

DEPLOYMENT_PRIVATE_KEY=""
INITIAL_OWNER="0x0000000000000000000000000000000000000000"
PROXY_PRIVATE_KEY=""

# === Chain =================================================================

CHAIN=flare
CHAIN_URL="https://flare-api.flare.network/ext/C/rpc"

# Does not exist yet — see the note above.
ADDRESSES_FILE="./config/flare/deployed-addresses.json"

LOCAL_MODE=false

# Never true on mainnet.
SIMULATED_TEE=false

# === Proxies ===============================================================

NORMAL_PROXY_URL=""
EXT_PROXY_URL=""

# === Extension =============================================================

LANGUAGE=go
# FEE_WEI=1000000000000
