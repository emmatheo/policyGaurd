# PolicyGuard XRPL — Coston2 deployment configuration.
#
# For the local demo (./scripts/run-tee.sh) you do not need this file at all.
# It is required only to deploy the contract and register the extension on Coston2.
#
# Copy to .env, or use .env.local.coston2 with:
#   bash ./scripts/use-chain.sh local coston2 go

# === Keys ==================================================================

# Funded Coston2 private key, hex, no 0x prefix. Used to deploy the contract and
# register the extension. Fund it at https://faucet.flare.network/coston2
DEPLOYMENT_PRIVATE_KEY=""

# The address derived from DEPLOYMENT_PRIVATE_KEY. Becomes the extension owner.
INITIAL_OWNER="0x0000000000000000000000000000000000000000"

# Key the locally-run ext-proxy signs with. Only used when running the proxy
# yourself; on Coston2 the hosted proxy uses its own key.
PROXY_PRIVATE_KEY=""

# === Chain =================================================================

CHAIN=coston2
CHAIN_URL="https://coston2-api.flare.network/ext/C/rpc"
ADDRESSES_FILE="./config/coston2/deployed-addresses.json"

# false for Coston2; true only for a local devnet.
LOCAL_MODE=false

# true runs a simulated TEE (test attestation, MODE=1 in the container).
# false requires a real GCP Confidential Space VM.
SIMULATED_TEE=true

# === Proxies ===============================================================

# Flare's hosted normal/FTDC proxy, used during TEE registration.
NORMAL_PROXY_URL="https://tee-proxy-coston2-1.flare.rocks"

# Your extension proxy, publicly reachable. Run `ngrok http 6674` and paste the
# HTTPS URL here, then re-run ./scripts/use-chain.sh.
EXT_PROXY_URL=""

# === Extension =============================================================

# Extension language. PolicyGuard is implemented in Go.
LANGUAGE=go

# Fee forwarded with each instruction, in wei. The registry minimum is 1000.
# FEE_WEI=1000000000000

# TEE governance signer set. Defaults to INITIAL_OWNER with a threshold of 1.
# GOVERNANCE_SIGNERS="0xAbc...,0xDef..."
# GOVERNANCE_THRESHOLD=2
