# PolicyGuard XRPL — Songbird.
#
# STATUS: PREPARED, NOT LIVE.
#
# Songbird governance approved the FCC rollout, but the Flare Confidential Compute
# contract set is not published in the official scaffold's address book: there is no
# config/songbird/deployed-addresses.json, and therefore no FlareTeeManager address for
# InstructionSender to point at.
#
# This file exists so that switching over is a configuration change rather than a code
# change. It will NOT work until Flare publishes the Songbird FCC addresses. Nothing
# here is a guess — the two blanks below are blank because the real values are not
# public yet, and filling them with placeholders would produce a deployment that fails
# in a confusing way instead of an obvious one.
#
# To bring this live:
#   1. Obtain the official Songbird FCC deployed-addresses.json from Flare.
#   2. Save it to config/songbird/deployed-addresses.json.
#   3. Fill in EXT_PROXY_URL and NORMAL_PROXY_URL below.
#   4. cp .env.songbird.example .env.songbird && bash ./scripts/use-chain.sh songbird go

# === Keys ==================================================================

DEPLOYMENT_PRIVATE_KEY=""
INITIAL_OWNER="0x0000000000000000000000000000000000000000"
PROXY_PRIVATE_KEY=""

# === Chain =================================================================

CHAIN=songbird
CHAIN_URL="https://songbird-api.flare.network/ext/C/rpc"

# Does not exist yet — see the note above.
ADDRESSES_FILE="./config/songbird/deployed-addresses.json"

LOCAL_MODE=false

# Songbird is a canary network carrying real value. A simulated TEE must not be used
# to guard real funds, so this stays false and a Confidential Space VM is required.
SIMULATED_TEE=false

# === Proxies ===============================================================

# Not published yet.
NORMAL_PROXY_URL=""
EXT_PROXY_URL=""

# === Extension =============================================================

LANGUAGE=go
# FEE_WEI=1000000000000
