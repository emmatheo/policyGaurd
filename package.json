{
  "name": "policyguard-xrpl",
  "version": "0.1.0",
  "private": true,
  "description": "A keyless, policy-controlled XRPL account powered by Flare Confidential Compute.",
  "scripts": {
    "contracts:build": "forge build",
    "contracts:bindings": "bash scripts/generate-bindings.sh",
    "test:go": "cd go && go test ./...",
    "test:contracts": "forge build",
    "dev": "npm --prefix frontend run dev",
    "install:frontend": "npm --prefix frontend install",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "typecheck": "npm --prefix frontend run typecheck",
    "verify:abi": "cd frontend && npm run verify:abi",
    "fcc:setup": "bash scripts/pre-build.sh",
    "fcc:start": "bash scripts/start-services.sh",
    "fcc:register": "bash scripts/post-build.sh",
    "fcc:test": "bash scripts/test.sh"
  }
}
